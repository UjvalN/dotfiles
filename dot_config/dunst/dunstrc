[global]
font = Monospace 16
geometry = "300x5-30+30"
timeout = 3000
format = "%s" 

[urgency_low]
timeout = 2
background = "#222222"
foreground = "#bbbbbb"

[urgency_normal]
timeout = 5
background = "#282828"
foreground = "#eeeeee"

[urgency_critical]
timeout = 0
background = "#900000"
foreground = "#ffffff"
